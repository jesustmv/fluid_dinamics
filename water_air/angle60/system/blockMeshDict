    (3.5 1 0.5)     //12
    (4 0.1339  0.5)//13
    (4.1 0.2339 0.5)//14
    (3.6 1 0.5)//15
);

blocks
(
    hex (0 1 2 3 4 5 6 7)
    (90 90 90 )
    simpleGrading (1 1 1)

    hex (8 9 10 11 12 13 14 15) 
   (90 90 90) 
   simpleGrading (1 1 1)
);

defaultPatch
{
    type empty;
}

boundary
(
    inlet
    {
        type patch;
        faces
        (
            (0 4 7 3)
        );
    }
    outlet
    {
        type patch;
        faces
        (
            (1 5 6 2)
        );
    }
    down
    {
        type symmetryPlane;
        faces
        (
            (0 4 5 1)
        );
    }

    up
    {
        type wall;
        faces
        (
            (3 7 6 2)
        );
    }

    walls
    {
        type empty;
        faces
        (
            (0 1 2 3)
            (4 5 6 7)
        );
    }
);


