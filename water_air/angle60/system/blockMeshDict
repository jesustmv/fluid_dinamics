convertToMeters 1;

vertices
(
    (0 0 0)      //0
    (10 0 0)  //1
    (10 1 0)  //2
    (0 1 0)  //3
    (0 0 0.5)  //4
    (10 0 0.5)  //5
    (10 1 0.5)  //6
    (0 1 0.5)  //7

    (3.5 1 0)     //8
    (4 0.1339 0)//9
    (4.1 0.2339 0)//10
